(footprint "MikroBUS_Socket_2x1x08_P2.54mm"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "mikroBUS socket: 2 x 1x08 female header, 2.54 mm pitch, rows 22.86 mm apart (mikroBUS Specification v2.00). Odd pads = left header AN..GND, even pads = right header PWM..GND, both numbered top to bottom. DNP: pads only, user fits their own socket and hand-solders it. Courtyard is deliberately split into two strips over the header bodies so the ~19.6 x 21.1 mm area between the rows stays open for components mounted UNDER the click board -- the microSD slot (1.8 mm tall) lives here. Parts placed in that gap must clear the mated socket height; see the note on Dwgs.User")
	(tags "mikroBUS socket click header 2.54mm 1x08")
